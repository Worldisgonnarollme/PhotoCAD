<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing leaves the device. Photos and drawings live in filesDir, and the database stores only
   their paths: a partial copy would restore points whose files are missing. The 25 MB Auto Backup
   quota makes a partial copy the normal outcome for a photo album, so the whole thing is off.
   allowBackup="false" covers cloud backup; device-to-device transfer is excluded here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
